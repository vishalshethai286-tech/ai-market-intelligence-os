// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum WorkspaceMemberStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
  INCOMPLETE
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum PlanKey {
  FREE_TRIAL
  STARTER
  PROFESSIONAL
  BUSINESS
  ENTERPRISE
}

enum OnboardingStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

/// A person who can sign in. Users are global — a single User can belong to
/// multiple Workspaces (tenants) via WorkspaceMember.
model User {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String?
  passwordHash    String?   @map("password_hash")
  avatarUrl       String?   @map("avatar_url")
  emailVerifiedAt DateTime? @map("email_verified_at")
  lastLoginAt     DateTime? @map("last_login_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  memberships              WorkspaceMember[]
  apiCostLogs              ApiCostLog[]
  usageLogs                UsageLog[]
  auditLogsActing          AuditLog[]        @relation("AuditLogActor")
  approvedCompanyProfiles  CompanyProfile[]  @relation("CompanyProfileApprovedBy")
  approvedProductServices  ProductService[]  @relation("ProductServiceApprovedBy")
  triggeredBrainUpdateRuns BrainUpdateRun[]  @relation("BrainUpdateRunTriggeredBy")
  verifiedBrainFacts       BrainFact[]       @relation("BrainFactVerifiedBy")
  brainFeedbackGiven       BrainFeedback[]

  @@index([deletedAt])
  @@map("users")
}

/// A tenant. All tenant-scoped data (members, subscription, usage, logs)
/// hangs off a Workspace.
model Workspace {
  id      String  @id @default(cuid())
  name    String
  slug    String  @unique
  logoUrl String? @map("logo_url")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  members            WorkspaceMember[]
  subscription       Subscription?
  onboarding         WorkspaceOnboarding?
  websiteAnalyses    WebsiteAnalysis[]
  companyProfile     CompanyProfile?
  productServices    ProductService[]
  businessBrain      BusinessBrain?
  brainFacts         BrainFact[]
  brainSources       BrainSource[]
  brainEntities      BrainEntity[]
  brainRelationships BrainRelationship[]
  brainUpdateRuns    BrainUpdateRun[]
  brainFeedback      BrainFeedback[]
  usageLogs          UsageLog[]
  apiCostLogs        ApiCostLog[]
  auditLogs          AuditLog[]

  @@index([deletedAt])
  @@map("workspaces")
}

/// Catalog of roles a WorkspaceMember can hold (e.g. OWNER, ADMIN, MEMBER,
/// VIEWER). Kept as a table rather than an enum so permissions can evolve
/// without a schema migration.
model Role {
  id          String  @id @default(cuid())
  key         String  @unique
  name        String
  description String?
  permissions Json    @default("[]")
  isSystem    Boolean @default(true) @map("is_system")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  members WorkspaceMember[]

  @@map("roles")
}

/// Join table between User and Workspace, carrying the member's Role and
/// membership lifecycle state within that tenant.
model WorkspaceMember {
  id          String                @id @default(cuid())
  workspaceId String                @map("workspace_id")
  userId      String                @map("user_id")
  roleId      String                @map("role_id")
  status      WorkspaceMemberStatus @default(INVITED)

  invitedAt DateTime? @map("invited_at")
  joinedAt  DateTime? @map("joined_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role      @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([roleId])
  @@index([deletedAt])
  @@map("workspace_members")
}

// ---------------------------------------------------------------------------
// Billing
// ---------------------------------------------------------------------------

/// Sellable plan catalog (Free Trial, Starter, Professional, Business,
/// Enterprise). Plans are configuration/reference data — retire a plan with
/// `isActive = false` instead of deleting it, since Subscriptions reference it.
model Plan {
  id          String  @id @default(cuid())
  key         PlanKey @unique
  name        String
  description String?

  priceCents      Int             @default(0) @map("price_cents")
  currency        String          @default("usd")
  billingInterval BillingInterval @default(MONTHLY) @map("billing_interval")
  trialDays       Int             @default(0) @map("trial_days")

  maxSeats      Int? @map("max_seats")
  maxWorkspaces Int? @map("max_workspaces")

  /// Metering limits, e.g. { "apiCallsPerMonth": 10000, "reportsPerMonth": 50 }
  usageLimits Json @default("{}") @map("usage_limits")

  /// Feature flags, e.g. ["ai_insights", "priority_support"]
  features Json @default("[]")

  isActive  Boolean @default(true) @map("is_active")
  sortOrder Int     @default(0) @map("sort_order")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  subscriptions Subscription[]

  @@index([isActive])
  @@map("plans")
}

/// A Workspace's current subscription to a Plan. One active subscription per
/// Workspace; historical billing events belong in a future Invoice model.
model Subscription {
  id          String @id @default(cuid())
  workspaceId String @unique @map("workspace_id")
  planId      String @map("plan_id")

  status SubscriptionStatus @default(TRIALING)
  seats  Int                @default(1)

  currentPeriodStart DateTime? @map("current_period_start")
  currentPeriodEnd   DateTime? @map("current_period_end")
  trialEndsAt        DateTime? @map("trial_ends_at")
  cancelAt           DateTime? @map("cancel_at")
  canceledAt         DateTime? @map("canceled_at")

  stripeCustomerId     String? @map("stripe_customer_id")
  stripeSubscriptionId String? @unique @map("stripe_subscription_id")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  plan      Plan      @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([planId])
  @@index([status])
  @@map("subscriptions")
}

// ---------------------------------------------------------------------------
// Metering & logs
//
// These are append-only records: no `updatedAt`/`deletedAt`, since rows are
// written once and never mutated. Retention/cleanup is a job, not a soft
// delete.
// ---------------------------------------------------------------------------

/// Product usage events, for metering against a Plan's usageLimits.
model UsageLog {
  id          String  @id @default(cuid())
  workspaceId String  @map("workspace_id")
  userId      String? @map("user_id")

  /// e.g. "api_call", "report_generated", "seat_active"
  metric   String
  quantity Decimal @default(1) @db.Decimal(20, 6)
  metadata Json?

  occurredAt DateTime @default(now()) @map("occurred_at")
  createdAt  DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workspaceId, metric, occurredAt])
  @@index([userId])
  @@map("usage_logs")
}

/// Cost of a single call to an external AI/API provider, for cost tracking
/// and margin analysis per workspace/user.
model ApiCostLog {
  id          String  @id @default(cuid())
  workspaceId String  @map("workspace_id")
  userId      String? @map("user_id")

  /// e.g. "anthropic", "openai"
  provider  String
  /// e.g. "claude-sonnet-5", "gpt-5"
  model     String
  /// e.g. "chat.completion", "embedding"
  operation String?

  promptTokens     Int    @default(0) @map("prompt_tokens")
  completionTokens Int    @default(0) @map("completion_tokens")
  totalTokens      Int    @default(0) @map("total_tokens")
  /// Cost in micro-units of `currency` (1,000,000 = 1.00) to avoid float rounding.
  costMicros       BigInt @default(0) @map("cost_micros")
  currency         String @default("usd")

  requestId String? @map("request_id")
  metadata  Json?

  occurredAt DateTime @default(now()) @map("occurred_at")
  createdAt  DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workspaceId, occurredAt])
  @@index([provider, model])
  @@index([userId])
  @@map("api_cost_logs")
}

/// Immutable trail of who did what. workspaceId is nullable to allow
/// platform-level events (e.g. login) that aren't scoped to a tenant.
model AuditLog {
  id          String  @id @default(cuid())
  workspaceId String? @map("workspace_id")
  actorId     String? @map("actor_id")

  /// e.g. "workspace.member.invited", "subscription.plan_changed"
  action     String
  targetType String? @map("target_type")
  targetId   String? @map("target_id")
  metadata   Json?

  ipAddress String? @map("ip_address")
  userAgent String? @map("user_agent")

  createdAt DateTime @default(now()) @map("created_at")

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor     User?      @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([actorId])
  @@index([action])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Onboarding
// ---------------------------------------------------------------------------

/// Tracks a Workspace's progress through the website-first onboarding wizard
/// (company website -> work email -> target countries -> customer types ->
/// start analysis). One row per Workspace, created lazily on first visit.
model WorkspaceOnboarding {
  id          String @id @default(cuid())
  workspaceId String @unique @map("workspace_id")

  companyWebsite String? @map("company_website")
  workEmail      String? @map("work_email")

  /// ISO country codes, e.g. ["US", "GB", "IN"]
  targetCountries String[] @map("target_countries")
  /// e.g. ["B2B", "ENTERPRISE"] — see src/config/onboarding.ts for the option list
  customerTypes   String[] @map("customer_types")

  status      OnboardingStatus @default(NOT_STARTED)
  /// Furthest step reached (1-5); lets a user resume where they left off.
  currentStep Int              @default(1) @map("current_step")

  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("workspace_onboarding")
}

// ---------------------------------------------------------------------------
// Website analysis
// ---------------------------------------------------------------------------

enum WebsiteAnalysisStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

/// Raw result of fetching + parsing a workspace's company homepage. One row
/// per analysis run (kept as history, not upserted), produced by
/// src/lib/website-analyzer.
model WebsiteAnalysis {
  id          String @id @default(cuid())
  workspaceId String @map("workspace_id")

  url    String
  status WebsiteAnalysisStatus @default(PENDING)
  /// Set when status is FAILED — network error, blocked by robots.txt, SSRF guard, etc.
  error  String?

  httpStatus    Int?     @map("http_status")
  robotsAllowed Boolean? @map("robots_allowed")

  title           String?
  metaDescription String? @map("meta_description")

  /// { h1: string[], h2: string[], h3: string[] }
  headings        Json?
  /// Visible body text, truncated to a sane length — not the raw HTML.
  visibleText     String? @map("visible_text")
  /// [{ href, text }], same-origin links found on the homepage (not crawled).
  internalLinks   Json?   @map("internal_links")
  /// { product: [...], service: [...], about: [...], industries: [...], catalog: [...], contact: [...] }
  identifiedPages Json?   @map("identified_pages")

  /// Full structured payload as returned by the analyzer, for debugging or
  /// reprocessing without re-fetching the page.
  rawResult Json? @map("raw_result")

  fetchedAt DateTime? @map("fetched_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  companyProfiles CompanyProfile[]
  productServices ProductService[]
  brainSources    BrainSource[]

  @@index([workspaceId, createdAt])
  @@index([status])
  @@map("website_analyses")
}

// ---------------------------------------------------------------------------
// Company profile (AI-extracted)
// ---------------------------------------------------------------------------

enum CompanyProfileStatus {
  PENDING_REVIEW
  APPROVED
}

/// How the company primarily operates, as inferred from its website.
enum CompanyOperationType {
  MANUFACTURER
  TRADER
  SERVICE_PROVIDER
  OTHER
  UNKNOWN
}

/// AI-extracted company profile for a workspace, generated from its latest
/// WebsiteAnalysis. One row per workspace (regenerating overwrites the
/// current draft) — the original AI output is preserved in `aiRawExtraction`
/// for audit even after a user edits the top-level fields. A user must
/// explicitly approve the profile before it's considered final.
model CompanyProfile {
  id                String  @id @default(cuid())
  workspaceId       String  @unique @map("workspace_id")
  websiteAnalysisId String? @map("website_analysis_id")

  companyName         String?              @map("company_name")
  businessDescription String?              @map("business_description")
  industry            String?
  /// e.g. "B2B", "B2C", "B2B2C", "Marketplace", "Direct-to-Consumer"
  businessModel       String?              @map("business_model")
  /// Country names as mentioned/implied on the site, not an ISO-code list.
  countriesServed     String[]             @map("countries_served")
  headquarters        String?
  operationType       CompanyOperationType @default(UNKNOWN) @map("operation_type")
  certifications      String[]
  keyProductsServices String[]             @map("key_products_services")

  /// 0-1, the model's self-reported confidence in this extraction.
  confidenceScore Float    @default(0) @map("confidence_score")
  /// URLs actually used as extraction input (currently just the analyzed homepage).
  sourceUrls      String[] @map("source_urls")

  /// The AI's original output for this profile, untouched by later user edits.
  aiRawExtraction Json? @map("ai_raw_extraction")

  status           CompanyProfileStatus @default(PENDING_REVIEW)
  approvedAt       DateTime?            @map("approved_at")
  approvedByUserId String?              @map("approved_by_user_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  websiteAnalysis WebsiteAnalysis? @relation(fields: [websiteAnalysisId], references: [id], onDelete: SetNull)
  approvedBy      User?            @relation("CompanyProfileApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([websiteAnalysisId])
  @@map("company_profiles")
}

// ---------------------------------------------------------------------------
// Product / service discovery (AI-extracted)
// ---------------------------------------------------------------------------

enum ProductServiceStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

/// AI-discovered product or service, generated from a workspace's website
/// content (homepage plus a bounded set of identified product/service/catalog
/// pages — see src/lib/product-discovery). Unlike CompanyProfile this is a
/// catalog: many rows per workspace. Regenerating replaces PENDING_REVIEW and
/// REJECTED rows with a fresh extraction but never touches APPROVED ones,
/// which are treated as a finalized human decision.
model ProductService {
  id                String  @id @default(cuid())
  workspaceId       String  @map("workspace_id")
  websiteAnalysisId String? @map("website_analysis_id")

  name             String
  category         String?
  subcategory      String?
  description      String?
  /// Use cases / applications mentioned for this product or service.
  applications     String[]
  targetIndustries String[] @map("target_industries")
  /// e.g. "OEM", "Distributor", "End consumer", "Government"
  buyerTypes       String[] @map("buyer_types")
  keywords         String[]

  /// URLs actually fetched and used as extraction input for this item.
  sourceUrls      String[] @map("source_urls")
  /// 0-1, the model's self-reported confidence in this extraction.
  confidenceScore Float    @default(0) @map("confidence_score")

  /// The AI's original output for this record, untouched by later user edits.
  aiRawExtraction Json? @map("ai_raw_extraction")

  status           ProductServiceStatus @default(PENDING_REVIEW)
  approvedAt       DateTime?            @map("approved_at")
  approvedByUserId String?              @map("approved_by_user_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  websiteAnalysis WebsiteAnalysis? @relation(fields: [websiteAnalysisId], references: [id], onDelete: SetNull)
  approvedBy      User?            @relation("ProductServiceApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status])
  @@index([websiteAnalysisId])
  @@map("product_services")
}

// ---------------------------------------------------------------------------
// AI Business Brain
//
// A per-workspace knowledge base built up over time from every source this
// app can read (website analysis today; documents/APIs/manual entry later).
// BusinessBrain is the aggregate root; BrainSource records where knowledge
// came from, BrainFact/BrainEntity/BrainRelationship are the knowledge itself
// (atomic facts, named entities, and edges between entities), and
// BrainUpdateRun is the history of refresh operations that populate them.
// ---------------------------------------------------------------------------

enum BusinessBrainStatus {
  INITIALIZING
  ACTIVE
  STALE
}

/// Broad knowledge categories a fact can belong to. OTHER is the escape
/// hatch for anything that doesn't fit yet — factType stays a bounded,
/// indexable enum instead of free text, but never blocks ingestion.
enum BrainFactType {
  COMPANY_NAME
  BUSINESS_DESCRIPTION
  INDUSTRY
  BUSINESS_MODEL
  HEADQUARTERS
  COUNTRY_SERVED
  OPERATION_TYPE
  CERTIFICATION
  PRODUCT_OR_SERVICE
  TARGET_INDUSTRY
  BUYER_TYPE
  KEYWORD
  CONTACT_INFO
  FINANCIAL
  LEADERSHIP
  COMPETITOR
  OTHER
}

/// A human's judgment on whether a fact is still accurate. Distinct from
/// confidenceScore (extraction accuracy at capture time) and freshnessScore
/// (automatic decay) — this is the one dimension only a person can set.
enum BrainFactVerificationStatus {
  UNVERIFIED
  CORRECT
  INCORRECT
  NEEDS_REVIEW
}

enum BrainEntityType {
  ORGANIZATION
  PERSON
  PRODUCT
  LOCATION
  CERTIFICATION
  INDUSTRY
  OTHER
}

enum BrainSourceType {
  WEBSITE_PAGE
  DOCUMENT
  MANUAL_ENTRY
  THIRD_PARTY_API
  OTHER
}

enum BrainUpdateRunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum BrainUpdateTrigger {
  ONBOARDING
  MANUAL
  SCHEDULED
  WEBSITE_ANALYSIS
}

/// The aggregate root of a workspace's knowledge base. One per workspace —
/// everything else in this section (facts, sources, entities, relationships,
/// update runs) hangs off a BusinessBrain, and also carries workspaceId
/// directly so it can be queried without a join.
model BusinessBrain {
  id          String @id @default(cuid())
  workspaceId String @unique @map("workspace_id")

  status        BusinessBrainStatus @default(INITIALIZING)
  lastUpdatedAt DateTime?           @map("last_updated_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  workspace     Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  facts         BrainFact[]
  sources       BrainSource[]
  entities      BrainEntity[]
  relationships BrainRelationship[]
  updateRuns    BrainUpdateRun[]
  feedback      BrainFeedback[]

  @@index([status])
  @@map("business_brains")
}

/// Where a piece of knowledge came from — a fetched page today, a document
/// or manual entry later. Optionally traceable back to the WebsiteAnalysis
/// run that produced it.
model BrainSource {
  id                String  @id @default(cuid())
  workspaceId       String  @map("workspace_id")
  brainId           String  @map("brain_id")
  websiteAnalysisId String? @map("website_analysis_id")

  sourceType BrainSourceType @default(WEBSITE_PAGE) @map("source_type")
  url        String?
  title      String?
  fetchedAt  DateTime?       @map("fetched_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  workspace       Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brain           BusinessBrain       @relation(fields: [brainId], references: [id], onDelete: Cascade)
  websiteAnalysis WebsiteAnalysis?    @relation(fields: [websiteAnalysisId], references: [id], onDelete: SetNull)
  facts           BrainFact[]
  relationships   BrainRelationship[]

  @@index([workspaceId])
  @@index([brainId])
  @@index([websiteAnalysisId])
  @@map("brain_sources")
}

/// A named "node" the brain has identified — an organization, person,
/// product, location, certification, etc. BrainRelationship connects two
/// entities; BrainFact can optionally attach to the entity it's about.
model BrainEntity {
  id          String @id @default(cuid())
  workspaceId String @map("workspace_id")
  brainId     String @map("brain_id")

  entityType      BrainEntityType @default(OTHER) @map("entity_type")
  name            String
  description     String?
  confidenceScore Float           @default(0) @map("confidence_score")
  /// Freeform extra attributes that don't warrant their own column, e.g. { "website": "..." }
  metadata        Json?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  workspace         Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brain             BusinessBrain       @relation(fields: [brainId], references: [id], onDelete: Cascade)
  facts             BrainFact[]
  relationshipsFrom BrainRelationship[] @relation("BrainRelationshipFromEntity")
  relationshipsTo   BrainRelationship[] @relation("BrainRelationshipToEntity")
  feedback          BrainFeedback[]

  @@index([workspaceId, entityType])
  @@index([brainId])
  @@map("brain_entities")
}

/// A directed edge between two BrainEntity nodes, e.g. "Acme Corp"
/// --CERTIFIED_BY--> "ISO 9001". relationshipType is free text (like
/// ProductService.category elsewhere) since the vocabulary of possible
/// relationships is open-ended, not a fixed set.
model BrainRelationship {
  id          String  @id @default(cuid())
  workspaceId String  @map("workspace_id")
  brainId     String  @map("brain_id")
  sourceId    String? @map("source_id")

  fromEntityId String @map("from_entity_id")
  toEntityId   String @map("to_entity_id")

  /// e.g. "HEADQUARTERED_IN", "CERTIFIED_BY", "MANUFACTURES", "COMPETES_WITH"
  relationshipType String @map("relationship_type")
  confidenceScore  Float  @default(0) @map("confidence_score")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  workspace  Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brain      BusinessBrain @relation(fields: [brainId], references: [id], onDelete: Cascade)
  source     BrainSource?  @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  fromEntity BrainEntity   @relation("BrainRelationshipFromEntity", fields: [fromEntityId], references: [id], onDelete: Cascade)
  toEntity   BrainEntity   @relation("BrainRelationshipToEntity", fields: [toEntityId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([brainId])
  @@index([fromEntityId])
  @@index([toEntityId])
  @@map("brain_relationships")
}

/// An atomic piece of knowledge. Every fact carries its own workspaceId
/// (queryable without a join through BusinessBrain), a bounded factType, the
/// value itself, where it came from, and two distinct scores: confidence is
/// about extraction accuracy at the time it was captured, freshness is about
/// how current it likely still is (decays since lastVerifiedAt; recalculated
/// by BrainUpdateRun).
model BrainFact {
  id          String  @id @default(cuid())
  workspaceId String  @map("workspace_id")
  brainId     String  @map("brain_id")
  sourceId    String? @map("source_id")
  entityId    String? @map("entity_id")

  factType  BrainFactType @map("fact_type")
  factValue String        @map("fact_value")

  /// Direct convenience copy of where this fact came from; the fuller source
  /// record (fetch time, type, etc.) is on `source` when `sourceId` is set.
  sourceUrl String? @map("source_url")

  confidenceScore Float     @default(0) @map("confidence_score")
  lastVerifiedAt  DateTime? @map("last_verified_at")
  /// 0-1; 1 is just-verified, decaying toward 0 the longer it goes unverified.
  freshnessScore  Float     @default(1) @map("freshness_score")

  /// A human's correct/incorrect/needs-review judgment. Marking CORRECT also
  /// bumps lastVerifiedAt/freshnessScore — a human confirming a fact IS a
  /// verification, not a separate concept.
  verificationStatus BrainFactVerificationStatus @default(UNVERIFIED) @map("verification_status")
  verifiedByUserId   String?                     @map("verified_by_user_id")

  /// Set by a refresh when re-extraction finds a different value for a fact
  /// a human has already verified CORRECT — the existing (approved) value is
  /// preserved in `factValue` rather than overwritten, this holds the newly
  /// proposed value so the review UI can show what changed, and
  /// verificationStatus flips to NEEDS_REVIEW. Cleared once the conflict is
  /// resolved (the value stops differing, or a human re-verifies).
  pendingFactValue String? @map("pending_fact_value")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  workspace  Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brain      BusinessBrain   @relation(fields: [brainId], references: [id], onDelete: Cascade)
  source     BrainSource?    @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  entity     BrainEntity?    @relation(fields: [entityId], references: [id], onDelete: SetNull)
  verifiedBy User?           @relation("BrainFactVerifiedBy", fields: [verifiedByUserId], references: [id], onDelete: SetNull)
  feedback   BrainFeedback[]

  @@index([workspaceId, factType])
  @@index([brainId])
  @@index([sourceId])
  @@index([entityId])
  @@map("brain_facts")
}

/// History of refresh operations that populate a BusinessBrain — analogous
/// to WebsiteAnalysis's run-history pattern. Lets the brain be rebuilt
/// incrementally and gives an audit trail of what changed and why.
model BrainUpdateRun {
  id          String @id @default(cuid())
  workspaceId String @map("workspace_id")
  brainId     String @map("brain_id")

  status  BrainUpdateRunStatus @default(PENDING)
  trigger BrainUpdateTrigger   @default(MANUAL)

  factsCreated Int @default(0) @map("facts_created")
  factsUpdated Int @default(0) @map("facts_updated")
  factsExpired Int @default(0) @map("facts_expired")
  /// Facts a human had verified CORRECT whose re-extracted value differed —
  /// left untouched (see BrainFact.pendingFactValue) rather than overwritten.
  factsFlagged Int @default(0) @map("facts_flagged")

  /// Set when status is FAILED.
  error String?

  triggeredByUserId String? @map("triggered_by_user_id")

  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brain       BusinessBrain @relation(fields: [brainId], references: [id], onDelete: Cascade)
  triggeredBy User?         @relation("BrainUpdateRunTriggeredBy", fields: [triggeredByUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([brainId])
  @@index([status])
  @@map("brain_update_runs")
}

/// A human's judgment used as a learning signal for future scoring and
/// discovery — distinct from BrainFact.verificationStatus (a single mutable
/// "is this fact still true" judgment). Feedback is append-only: a fact or
/// entity can accumulate many feedback events over time, each contributing to
/// a tally rather than overwriting the last one. GOOD_LEAD/BAD_LEAD have no
/// lead data model yet, so they attach via `subjectLabel` instead of a
/// fact/entity id until lead discovery exists.
enum BrainFeedbackType {
  GOOD_LEAD
  BAD_LEAD
  CORRECT_PRODUCT
  INCORRECT_PRODUCT
  GOOD_INDUSTRY
  BAD_INDUSTRY
}

model BrainFeedback {
  id          String @id @default(cuid())
  workspaceId String @map("workspace_id")
  brainId     String @map("brain_id")

  feedbackType BrainFeedbackType @map("feedback_type")

  entityId     String? @map("entity_id")
  factId       String? @map("fact_id")
  /// Freeform subject when there's no fact/entity row to attach to yet, e.g.
  /// a lead's company name before lead discovery exists.
  subjectLabel String? @map("subject_label")

  note String?

  userId String @map("user_id")

  createdAt DateTime @default(now()) @map("created_at")

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brain     BusinessBrain @relation(fields: [brainId], references: [id], onDelete: Cascade)
  entity    BrainEntity?  @relation(fields: [entityId], references: [id], onDelete: SetNull)
  fact      BrainFact?    @relation(fields: [factId], references: [id], onDelete: SetNull)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, feedbackType])
  @@index([brainId])
  @@index([entityId])
  @@index([factId])
  @@map("brain_feedback")
}
