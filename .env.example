# Copy this file to .env and fill in real values for local development:
#   cp .env.example .env
#
# Variables marked REQUIRED are checked at server startup (src/instrumentation.ts
# + src/lib/env.ts) — the app refuses to start with a clear error if any are
# missing. Everything else is OPTIONAL: it gates one specific feature and the
# rest of the app works fine without it (the feature just won't do anything
# until you add a real value).
#
# Never commit real values. This file must only ever contain placeholders.

# ---------------------------------------------------------------------------
# Core application
# ---------------------------------------------------------------------------

# Base URL of the app, used for links/redirects. REQUIRED.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# MongoDB connection string used by Mongoose. REQUIRED.
# Local dev: install MongoDB Community Server and use the URI below as-is.
# Production: use a MongoDB Atlas connection string instead.
MONGODB_URI="mongodb://localhost:27017/ai_market_intelligence_os"

# ---------------------------------------------------------------------------
# Authentication (Auth.js)
# ---------------------------------------------------------------------------

# Session/JWT signing secret, read implicitly by Auth.js. REQUIRED.
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-32-byte-base64-string"

# ---------------------------------------------------------------------------
# Stripe (billing)
# ---------------------------------------------------------------------------
# OPTIONAL — gates the billing checkout flow (src/lib/billing,
# /dashboard/billing's Upgrade buttons, POST /api/webhooks/stripe). Without
# STRIPE_SECRET_KEY, the billing page still renders (read-only plan catalog)
# but Upgrade returns a clear "not configured" error instead of starting
# checkout. Each Plan also needs its `stripePriceId` column set to a real
# Stripe Price id (price_...) — seeded plans have none by default, so
# checkout shows "Contact sales" until you set one per plan you want
# self-serve checkout for.

# See: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_test_replace-with-your-stripe-secret-key"
# Publishable key for client-side Stripe.js — NOT currently used (checkout
# redirects to a Stripe-hosted page, no Stripe.js/Elements in the browser).
# Reserved for if an embedded checkout is built later.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_replace-with-your-stripe-publishable-key"
# Signing secret for verifying incoming Stripe webhook events.
# See: https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET="whsec_replace-with-your-stripe-webhook-secret"

# ---------------------------------------------------------------------------
# AI providers
# ---------------------------------------------------------------------------
# OPTIONAL at startup, but effectively required for this app's core AI
# features (website analysis extraction, product discovery, Business Brain
# synthesis, competitor identification) — those calls fail gracefully
# (skip/return empty) rather than crashing the app when this is unset.

# See: https://platform.claude.com
ANTHROPIC_API_KEY="replace-with-your-anthropic-api-key"

# Forces src/lib/ai-extraction's deterministic mock extractors (no network,
# no cost) instead of a real Claude call. Also engages automatically whenever
# ANTHROPIC_API_KEY is unset, so onboarding always works end-to-end without a
# key in local dev/CI/tests — set this to "true" explicitly to mock even with
# a real key configured (e.g. to avoid burning API cost while iterating on UI).
ENABLE_MOCK_AI="false"

# OPTIONAL, test-only. The normal `npm test` run never calls a real AI
# provider — every AI-dependent test either exercises the mock path directly
# or explicitly stubs ENABLE_MOCK_AI=true. src/lib/ai-extraction/live-anthropic.test.ts
# is the one exception: it makes a real Claude call to verify the non-mock
# path end-to-end, and only runs when this is set to "true" (in addition to a
# real ANTHROPIC_API_KEY). Leave unset for normal local/CI test runs.
RUN_LIVE_AI_TESTS="false"

# ---------------------------------------------------------------------------
# Search providers (src/lib/search) — used by the Discovery Brain's Search
# Execution Engine (src/lib/discovery-brain/executor.ts) and by the older
# AI-grounded target-company search (src/lib/target-companies).
# ---------------------------------------------------------------------------
# OPTIONAL. Which provider search() uses when a caller doesn't specify one
# explicitly. Defaults to MOCK (no network, no key needed) if unset or
# unrecognized, so the app never breaks without search API keys configured.
# One of: TAVILY, EXA, BING, GOOGLE_CSE, SERPAPI, MOCK.
SEARCH_PROVIDER="tavily"

# Only needed if SEARCH_PROVIDER (or an explicit provider override) uses it.
# See: https://docs.tavily.com
TAVILY_API_KEY=""
# See: https://docs.exa.ai
EXA_API_KEY=""
# See: https://www.microsoft.com/en-us/bing/apis/bing-web-search-api
BING_SEARCH_API_KEY=""
# See: https://developers.google.com/custom-search/v1/overview
GOOGLE_CSE_API_KEY=""
GOOGLE_CSE_CX=""
# See: https://serpapi.com/
SERPAPI_API_KEY=""

# OPTIONAL. When "true", search() always uses the mock provider regardless of
# SEARCH_PROVIDER — no network call, no key needed, deterministic
# query-and-searchType-aware fake results. Useful for demos/tests without
# burning real search-provider quota. Outside production, a configured
# SEARCH_PROVIDER whose API key is missing also falls back to mock
# automatically; in production a missing key is a hard configuration error
# instead (see src/lib/search/service.ts).
ENABLE_MOCK_SEARCH="true"

# OPTIONAL. Per-request timeout for a single search-provider call made by the
# Discovery Brain's Search Execution Engine. Milliseconds.
DISCOVERY_SEARCH_TIMEOUT_MS="15000"

# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------
# OPTIONAL — gates password reset and workspace-invite emails
# (src/lib/email). Without RESEND_API_KEY, sendEmail() falls back to a
# no-network mock provider that logs instead of sending — password
# reset/invite still work end-to-end locally, just without a real email.

# Which provider to use. Currently only "resend" is implemented.
EMAIL_PROVIDER="resend"
# See: https://resend.com/api-keys
RESEND_API_KEY="re_replace-with-your-resend-api-key"
# "From" address used on outgoing email. Must be a verified sender/domain.
EMAIL_FROM="AI Market Intelligence OS <noreply@yourdomain.com>"

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# OPTIONAL — reserved for future file uploads (e.g. logos, report exports);
# no code reads/writes storage yet.

# Vercel Blob read/write token, since this app deploys on Vercel.
# See: https://vercel.com/docs/storage/vercel-blob
BLOB_READ_WRITE_TOKEN="replace-with-your-vercel-blob-token"

# ---------------------------------------------------------------------------
# Queue / Cron
# ---------------------------------------------------------------------------
# OPTIONAL, but required in production once a cron route is actually
# scheduled. Two cron-ready routes exist: GET /api/cron/discovery (older
# continuous target-company discovery) and GET /api/cron/discovery-run (the
# Discovery Brain's daily Search Execution Engine batch, src/lib/discovery-brain/daily.ts).
# Neither is wired into vercel.json's `crons` yet — manual triggers
# ("Run discovery now" / "Run Discovery Now") are the primary path for now.

# Shared secret Vercel Cron sends as a Bearer token so a cron-triggered route
# can verify the request actually came from Vercel Cron, not the public internet.
# See: https://vercel.com/docs/cron-jobs/manage-cron-jobs#securing-cron-jobs
CRON_SECRET="replace-with-a-random-secret"

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# OPTIONAL — no structured logging library is wired in yet; this is reserved
# for when one is added.

# One of: debug, info, warn, error.
LOG_LEVEL="info"

# ---------------------------------------------------------------------------
# Global discovery
# ---------------------------------------------------------------------------
# OPTIONAL. Shared by two independent features, each with its own in-code
# fallback if this is unset: the older continuous target-company discovery
# job (src/lib/discovery, falls back to 25) and the Discovery Brain's Search
# Execution Engine (src/lib/discovery-brain/executor.ts, falls back to 10).
# Max search queries/queue items processed per workspace per run.
DISCOVERY_BATCH_SIZE="10"

# ---------------------------------------------------------------------------
# Platform admin
# ---------------------------------------------------------------------------
# OPTIONAL — grants access to /platform-admin (read-only cross-workspace
# overview: workspaces, users, usage) to whichever signed-in user's email is
# in this list. Checked directly against the session, independent of any
# workspace membership/role — see src/lib/platform-admin.ts.

# Comma-separated list of emails granted platform-admin access.
PLATFORM_ADMIN_EMAILS=""

# ---------------------------------------------------------------------------
# Feature flags
# ---------------------------------------------------------------------------
# OPTIONAL — reserved for future feature-flag rollout; no flag provider is
# wired into any code path yet.

# One of: growthbook, none.
FEATURE_FLAGS_PROVIDER="none"
# See: https://www.growthbook.io
GROWTHBOOK_CLIENT_KEY="replace-with-your-growthbook-client-key"
